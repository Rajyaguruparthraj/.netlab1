#_FeedbackFromtPartial.cshtml 
@model FeedbackModule.Models.FeedbackModel 
 
@using (Html.BeginForm("Create", "Feedback", FormMethod.Post)) { 
    <!-- CSRF Protection Token --> 
    @Html.AntiForgeryToken() 
 
    <!-- Displays overall form errors if any model-level validation fails -->     @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })  
    <!-- Full Name Input --> 
    <div class="mb-3"> 
        @Html.LabelFor(m => m.UserName, new { @class = "form-label fw-bold" }) 
        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Enter full name" }) 
        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "textdanger small" }) 
    </div> 
 
    <!-- Email Address Input --> 
    <div class="mb-3"> 
        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" }) 
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = 
"email", placeholder = "name@example.com" }) 
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })     </div> 
 
    <div class="row"> 
        <!-- Category Dropdown --> 
        <div class="col-md-6 mb-3"> 
            @Html.LabelFor(m => m.Category, new { @class = "form-label fw-bold" }) 
            @Html.DropDownListFor(m => m.Category, new SelectList(new[] { 
            "General Feedback", "Bug Report", "Feature Request", "UI/UX 
Improvement" 
                }), "-- Select Category --", new { @class = "form-select" }) 
        @Html.ValidationMessageFor(m => m.Category, "", new { @class = "textdanger small" }) 
    </div> 
 
    <!-- Rating Dropdown --> 
    <div class="col-md-6 mb-3"> 
        @Html.LabelFor(m => m.Rating, new { @class = "form-label fw-bold" }) 
        @Html.DropDownListFor(m => m.Rating, new SelectList(new[] { 1, 2, 3, 4, 
5 }), "-- Select Rating (1-5) --", new { @class = "form-select" }) 
        @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "textdanger small" }) 
    </div> 
</div> 
 
<!-- Comments TextArea --> 
<div class="mb-3"> 
    @Html.LabelFor(m => m.Comments, new { @class = "form-label fw-bold" }) 
    @Html.TextAreaFor(m => m.Comments, new { @class = "form-control", rows = 
"4", placeholder = "Write detailed feedback..." }) 
    @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "text-danger small" }) 
</div> 
 
<!-- Action Buttons --> 
<button type="submit" class="btn btn-primary">Submit Feedback</button> 
<a href="@Url.Action("Index", "Feedback")" class="btn btn-outline-secondary ms2">Cancel</a> 
} 
 
 
 
 
 
 
