#FeedbackController.cs using System; 
using System.Collections.Generic; using System.Linq; using Microsoft.AspNetCore.Mvc; using FeedbackModule.Models; 
 
namespace FeedbackModule.Controllers 
{ 
    public class FeedbackController : Controller 
    { 
        // Static in-memory collection simulating database records         private static readonly List<FeedbackModel> FeedbackList = new 
List<FeedbackModel> 
        { 
            new FeedbackModel 
            { 
                Id = 1, 
                UserName = "Jane Doe", 
                Email = "jane@example.com", 
                Category = "UI/UX", 
                Rating = 5, 
                Comments = "The user interface is clean and easy to navigate!", 
                SubmittedDate = DateTime.Now.AddDays(-1) 
            } 
        }; 
 
        // GET: /Feedback/Index 
        [HttpGet] 
        public IActionResult Index() 
        { 
            var orderedList = FeedbackList.OrderByDescending(f => f.SubmittedDate).ToList(); 
            return View(orderedList); 
        } 
 
        // GET: /Feedback/Create 
        [HttpGet] 
        public IActionResult Create() 
        { 
            return View(new FeedbackModel()); 
        } 
 
        // POST: /Feedback/Create 
        [HttpPost] 
        [ValidateAntiForgeryToken] 
        public IActionResult Create(FeedbackModel model) 
        { 
            // Server-side validation check             if (!ModelState.IsValid) 
            { 
                return View(model); 
            } 
             model.Id = FeedbackList.Count + 1;             model.SubmittedDate = DateTime.Now; 
            FeedbackList.Add(model); 
 
            TempData["SuccessMessage"] = "Feedback submitted successfully!";             return RedirectToAction("Index"); 
        } 
    } 
} 
 
 
 
 
 
#FeedbackModel.cs using System; 
using System.ComponentModel.DataAnnotations; 
 
namespace FeedbackModule.Models 
{ 
    public class FeedbackModel 
    { 
        public int Id { get; set; } 
 
        [Required(ErrorMessage = "Full Name is required.")] 
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Name must be between 3 and 50 characters.")]         [Display(Name = "Full Name")]         public string UserName { get; set; } 
 
        [Required(ErrorMessage = "Email Address is required.")] 
        [EmailAddress(ErrorMessage = "Enter a valid email address.")] 
        [Display(Name = "Email Address")]         public string Email { get; set; } 
 
        [Required(ErrorMessage = "Please select a Category.")] 
        [Display(Name = "Category")]         public string Category { get; set; } 
 
        [Required(ErrorMessage = "Please select a Rating.")] 
        [Range(1, 5, ErrorMessage = "Rating must be between 1 and 5.")] 
        [Display(Name = "Rating")]         public int Rating { get; set; } 
 
        [Required(ErrorMessage = "Comments cannot be empty.")] 
        [StringLength(500, MinimumLength = 10, ErrorMessage = "Comments must be between 10 and 500 characters.")]         [Display(Name = "Comments")] 
        public string Comments { get; set; } 
 
        public DateTime SubmittedDate { get; set; } = DateTime.Now;     } } 
 
 
 
 
 
 
 
 
 
